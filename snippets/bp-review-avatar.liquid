{%- comment -%}
  Renders a Google-style circular avatar with the first letter of a reviewer's name.
  Usage: {% render 'bp-review-avatar', name: block.settings.name %}
  Color is picked deterministically from the name so the same reviewer always gets the same color.
{%- endcomment -%}
{%- liquid
  assign avatar_palette = 'e57373,f06292,ba68c8,9575cd,7986cb,64b5f6,4fc3f7,4dd0e1,4db6ac,81c784,aed581,ffb74d,ff8a65,a1887f,90a4ae' | split: ','
  assign clean_name = name | strip
  assign first_char = clean_name | slice: 0, 1 | upcase
  if first_char == blank
    assign first_char = '?'
  endif
  assign name_size = clean_name.size
  assign palette_size = avatar_palette.size
  assign color_index = name_size | modulo: palette_size
  assign avatar_color = avatar_palette[color_index]
-%}
<span class="bp-rd-avatar" style="background:#{{ avatar_color }};" aria-hidden="true">{{ first_char }}</span>
