{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-hero-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-hero-{{ section.id }} .bp-hero-grid{
      max-width:1180px; margin:0 auto; padding:64px 24px;
      display:grid; grid-template-columns: 1fr 1fr; gap:48px; align-items:center;
    }
    .bp-hero-{{ section.id }} h1{ font-size:44px; line-height:1.1; margin-bottom:18px; }
    .bp-hero-{{ section.id }} h1 .bp-accent{ color:{{ section.settings.accent_color }}; }
    .bp-hero-{{ section.id }} p.bp-sub{ font-size:16px; color:var(--bp-muted); max-width:460px; margin-bottom:26px; }
    .bp-hero-{{ section.id }} .bp-hero-ctas{ display:flex; gap:14px; flex-wrap:wrap; margin-bottom:22px; }
    .bp-hero-{{ section.id }} .bp-hero-stats{ display:flex; align-items:center; gap:10px; font-size:14px; color:var(--bp-muted); margin-bottom:18px; }
    .bp-hero-{{ section.id }} .bp-hero-badges{ display:flex; gap:18px; flex-wrap:wrap; font-size:13px; color:var(--bp-muted); }
    .bp-hero-{{ section.id }} .bp-hero-badges span{ display:flex; align-items:center; gap:6px; }
    .bp-hero-{{ section.id }} .bp-hero-visual{
      position:relative; background: rgba(255,255,255,.5);
      border-radius: 24px; min-height:420px; display:flex; align-items:center; justify-content:center;
      overflow:hidden;
    }
    .bp-hero-{{ section.id }} .bp-hero-visual img{ width:100%; height:100%; object-fit:cover; }
    .bp-hero-{{ section.id }} .bp-callout{
      position:absolute; background:#fff; border-radius:999px; padding:9px 16px;
      font-size:13px; font-weight:600; box-shadow:0 6px 20px rgba(43,30,34,.12);
      display:flex; align-items:center; gap:6px;
    }
    .bp-hero-{{ section.id }} .bp-callout--top{ top:24px; left:24px; }
    .bp-hero-{{ section.id }} .bp-callout--bottom{ bottom:24px; right:24px; }
    @media (max-width:900px){
      .bp-hero-{{ section.id }} .bp-hero-grid{ grid-template-columns: 1fr; padding:40px 20px; }
      .bp-hero-{{ section.id }} h1{ font-size:32px; }
      .bp-hero-{{ section.id }} .bp-hero-visual{ order: -1; min-height:280px; }
      .bp-hero-{{ section.id }} .bp-hero-info{ order: 1; }
    }
  </style>

  <div class="bp-hero-grid">
    <div class="bp-hero-info">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }} <span class="bp-accent">{{ section.settings.heading_accent }}</span></h1>
      <p class="bp-sub">{{ section.settings.subtext }}</p>
      <div class="bp-hero-ctas">
        <a href="{{ section.settings.cta_link }}" class="bp-btn">{{ section.settings.cta_text }} →</a>
        <a href="{{ section.settings.reviews_link }}" class="bp-btn bp-btn--outline">{{ section.settings.reviews_text }}</a>
      </div>
      <div class="bp-hero-stats">
        <span>{{ section.settings.stars }}</span>
        <span>{{ section.settings.rating_text }}</span>
      </div>
      <div class="bp-hero-badges">
        <span>🇬🇧 Free UK shipping</span>
        <span>↩ {{ section.settings.returns_days }}-day returns</span>
        <span>🔒 Secure checkout</span>
      </div>
    </div>

    <div class="bp-hero-visual">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager">
      {% else %}
        <div style="color: var(--bp-muted); font-family: var(--bp-sans);">Add a product image in section settings</div>
      {% endif %}
      {% if section.settings.callout_top != blank %}
        <div class="bp-callout bp-callout--top">✏️ {{ section.settings.callout_top }}</div>
      {% endif %}
      {% if section.settings.callout_bottom != blank %}
        <div class="bp-callout bp-callout--bottom">✏️ {{ section.settings.callout_bottom }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP Hero",
  "tag": "section",
  "class": "section-bp-hero",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fbe9ec" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#c96a86" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ADJUSTABLE RABBIT STAND" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hands-free calls," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent line", "default": "hop to it." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Bunny Perch holds your phone or tablet at any angle you need — video calls, recipes, shows in bed — on a stable base with soft anti-slip padding." },
    { "type": "text", "id": "cta_text", "label": "Primary CTA text", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "reviews_text", "label": "Secondary CTA text", "default": "See 1,300+ reviews" },
    { "type": "url", "id": "reviews_link", "label": "Secondary CTA link" },
    { "type": "text", "id": "stars", "label": "Star rating display", "default": "★★★★★" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.8/5 from 1,317 verified UK customers" },
    { "type": "text", "id": "returns_days", "label": "Returns window (days)", "default": "45" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "callout_top", "label": "Top callout text", "default": "Multi-angle tilt" },
    { "type": "text", "id": "callout_bottom", "label": "Bottom callout text", "default": "Anti-slip padding" }
  ],
  "presets": [{ "name": "BP Hero" }]
}
{% endschema %}
