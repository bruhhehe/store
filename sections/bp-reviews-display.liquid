{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div id="bp-reviews-display" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section bp-reviews-display-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  {%- liquid
    assign rd_5 = section.settings.star_5_count
    assign rd_4 = section.settings.star_4_count
    assign rd_3 = section.settings.star_3_count
    assign rd_2 = section.settings.star_2_count
    assign rd_1 = section.settings.star_1_count
    assign rd_total = rd_5 | plus: rd_4 | plus: rd_3 | plus: rd_2 | plus: rd_1
    assign rd_pct_5 = 0
    assign rd_pct_4 = 0
    assign rd_pct_3 = 0
    assign rd_pct_2 = 0
    assign rd_pct_1 = 0
    if rd_total > 0
      assign rd_pct_5 = rd_5 | times: 100.0 | divided_by: rd_total
      assign rd_pct_4 = rd_4 | times: 100.0 | divided_by: rd_total
      assign rd_pct_3 = rd_3 | times: 100.0 | divided_by: rd_total
      assign rd_pct_2 = rd_2 | times: 100.0 | divided_by: rd_total
      assign rd_pct_1 = rd_1 | times: 100.0 | divided_by: rd_total
    endif
  -%}
  <style>
    .bp-reviews-display-{{ section.id }} .bp-rd-summary {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 40px;
      align-items: center;
      background: #fff;
      border: 1px solid rgba(43,30,34,.08);
      border-radius: var(--bp-radius);
      padding: 32px;
      margin-top: 28px;
      margin-bottom: 36px;
    }
    @media screen and (max-width: 749px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-summary {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 24px;
        padding: 26px 22px;
      }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-overall {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      min-width: 130px;
    }
    @media screen and (max-width: 749px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-overall { align-items: center; }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-overall-number {
      font-family: var(--bp-serif);
      font-size: 48px;
      line-height: 1;
      color: var(--bp-ink);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-overall-count {
      font-size: 13px;
      color: var(--bp-muted);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-trust {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-trust-desc {
      font-size: 15px;
      color: var(--bp-ink);
      margin: 0;
      line-height: 1.5;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-trust-items {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-trust-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--bp-ink);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-trust-item svg {
      width: 18px;
      height: 18px;
      flex: none;
      color: var(--bp-pink);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-cta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      min-width: 180px;
    }
    @media screen and (max-width: 749px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-cta { align-items: center; }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-cta-label {
      font-size: 13px;
      font-weight: 700;
      color: var(--bp-ink);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 8px;
    }
    @media screen and (max-width: 989px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media screen and (max-width: 640px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-grid { grid-template-columns: 1fr; }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-card {
      background: #fff;
      border: 1px solid rgba(43,30,34,.08);
      border-radius: var(--bp-radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-card-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex-grow: 1;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-header {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-photos {
      display: flex;
      flex-wrap: wrap;
      flex: none;
      gap: 6px;
      max-width: 100%;
      justify-content: flex-end;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-photo-btn {
      width: 90px;
      height: 90px;
      flex: none;
      margin: 0;
      padding: 0;
      border: 1px solid rgba(43,30,34,.12);
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      background: none;
      display: block;
    }
    @media screen and (max-width: 480px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-photo-btn {
        width: 68px;
        height: 68px;
      }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-photo-btn:hover {
      border-color: {{ section.settings.bg_color | color_darken: 30 }};
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-photos img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1200;
      background: rgba(20,14,16,.82);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 32px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox.is-open {
      display: flex;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-inner {
      position: relative;
      display: block;
      max-width: min(90vw, 520px);
      max-height: 85vh;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox img {
      max-width: min(90vw, 520px);
      max-height: 85vh;
      border-radius: 14px;
      display: block;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-close {
      position: absolute;
      top: -16px;
      right: -16px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,.15);
      color: #fff;
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-close:hover {
      background: rgba(255,255,255,.25);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: none;
      background: rgba(255,255,255,.15);
      color: #fff;
      font-size: 26px;
      line-height: 1;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-nav.is-visible {
      display: flex;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-nav:hover {
      background: rgba(255,255,255,.25);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-prev {
      left: -14px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-next {
      right: -14px;
    }
    @media screen and (max-width: 640px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-prev { left: 4px; }
      .bp-reviews-display-{{ section.id }} .bp-rd-lightbox-next { right: 4px; }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-quote {
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--bp-ink);
      flex-grow: 1;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 12px;
      color: var(--bp-muted);
      border-top: 1px solid rgba(43,30,34,.08);
      padding-top: 10px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-name { font-weight: 700; color: var(--bp-ink); }
    .bp-reviews-display-{{ section.id }} .bp-rd-variant {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .03em;
      text-transform: uppercase;
      color: var(--bp-pink-deep);
      margin-bottom: 2px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-stars {
      color: #d9a441;
      font-size: 14px;
      letter-spacing: 1px;
      line-height: 1;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-overall .bp-rd-stars { font-size: 18px; }
    .bp-reviews-display-{{ section.id }} .bp-rd-stars .bp-rd-star-empty { color: rgba(43,30,34,.18); }
    .bp-reviews-display-{{ section.id }} .bp-rd-star-half {
      position: relative;
      display: inline-block;
      color: rgba(43,30,34,.18);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-star-half::before {
      content: '★';
      position: absolute;
      top: 0;
      left: 0;
      width: 50%;
      overflow: hidden;
      color: #d9a441;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-verified {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(30, 158, 92, 0.12);
      color: #1e6b41;
      font-size: 13px;
      font-weight: 600;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-verified svg {
      width: 16px;
      height: 16px;
      flex: none;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-more {
      margin-top: 24px;
      padding: 32px 24px;
      border-radius: 16px;
      background: rgba(43,30,34,.03);
      border: 1px solid rgba(43,30,34,.08);
      text-align: center;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-more svg {
      width: 30px;
      height: 30px;
      color: var(--bp-pink);
      margin-bottom: 8px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-more h3 {
      margin: 0 0 4px;
      font-size: 19px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-more p {
      margin: 0 0 16px;
      color: var(--bp-muted);
      font-size: 14px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal {
      position: fixed;
      inset: 0;
      z-index: 1100;
      display: none;
      align-items: flex-end;
      justify-content: center;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal.is-open {
      display: flex;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20,14,16,.55);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-panel {
      position: relative;
      width: 100%;
      max-width: 900px;
      max-height: 86vh;
      background: #fff;
      border-radius: 20px 20px 0 0;
      display: flex;
      flex-direction: column;
      box-shadow: 0 -8px 40px rgba(0,0,0,.25);
      animation: bpRdModalUp .28s ease;
    }
    @media screen and (min-width: 750px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-modal {
        align-items: center;
      }
      .bp-reviews-display-{{ section.id }} .bp-rd-modal-panel {
        border-radius: 20px;
        max-height: 80vh;
      }
    }
    @keyframes bpRdModalUp {
      from { transform: translateY(24px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 22px;
      border-bottom: 1px solid rgba(43,30,34,.08);
      flex: none;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-head h3 {
      margin: 0;
      font-size: 18px;
      color: var(--bp-ink);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-count {
      font-weight: 400;
      color: var(--bp-muted);
      font-size: 14px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-close {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: none;
      background: rgba(43,30,34,.06);
      color: var(--bp-ink);
      font-size: 16px;
      cursor: pointer;
      flex: none;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-close:hover {
      background: rgba(43,30,34,.12);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-body {
      overflow-y: auto;
      padding: 20px 22px 28px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-modal-loading {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--bp-muted);
      font-size: 14px;
      padding: 40px 0;
    }
    @media screen and (max-width: 640px) {
      .bp-reviews-display-{{ section.id }} .bp-rd-modal-grid {
        grid-template-columns: 1fr;
      }
    }
    body.bp-rd-modal-lock {
      overflow: hidden;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-meta {
      align-items: center;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-who {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-avatar {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-panel form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .05em;
      text-transform: uppercase;
      color: var(--bp-muted);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field input[type="text"],
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field input[type="email"],
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field textarea {
      background: #fff;
      border: 1px solid rgba(43,30,34,.15);
      border-radius: var(--bp-radius-sm);
      padding: 12px 14px;
      font-size: 15px;
      font-family: var(--bp-sans);
      color: var(--bp-ink);
      outline: none;
      transition: border-color .15s ease;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field input:focus,
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field textarea:focus {
      border-color: var(--bp-pink-deep);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-field textarea {
      min-height: 110px;
      resize: vertical;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-stars {
      display: flex;
      gap: 6px;
      font-size: 28px;
      line-height: 1;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-star {
      cursor: pointer;
      opacity: .3;
      transition: opacity .12s ease, transform .12s ease;
      user-select: none;
      background: none;
      border: none;
      padding: 0;
      color: #d9a441;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-star:hover {
      transform: scale(1.12);
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-star.is-active {
      opacity: 1;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-error {
      font-size: 13px;
      color: #c0392b;
      margin-top: -8px;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-submit {
      align-self: flex-start;
    }
    .bp-reviews-display-{{ section.id }} .bp-rd-write-success {
      background: rgba(30, 158, 92, .08);
      border: 1px solid rgba(30, 158, 92, .25);
      border-radius: var(--bp-radius-sm);
      padding: 18px 20px;
      font-size: 15px;
      line-height: 1.6;
      color: var(--bp-ink);
    }
  </style>

  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom: 8px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
      <span class="bp-rd-verified">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="10" cy="10" r="10" fill="#1e9e5c"/>
          <path d="M5.5 10.2L8.3 13L14.5 6.8" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All from verified purchases
      </span>
    </div>

    <div class="bp-rd-summary">
      <div class="bp-rd-overall">
        <span class="bp-rd-overall-number">{{ section.settings.overall_rating }}</span>
        <span class="bp-rd-stars bp-rd-stars-half" aria-hidden="true">★★★★<span class="bp-rd-star-half">★</span></span>
        <span class="bp-rd-overall-count">{{ rd_total }} reviews</span>
      </div>

      <div class="bp-rd-trust">
        <p class="bp-rd-trust-desc">{{ section.settings.trust_description }}</p>
        <div class="bp-rd-trust-items">
          <span class="bp-rd-trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.5 10.2L8.3 13L14.5 6.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_text_1 }}
          </span>
          <span class="bp-rd-trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M10 17s-6.5-4.1-6.5-8.6C3.5 5.7 5.4 4 7.6 4c1 0 2 .4 2.7 1.2l-.3.3.3-.3c.7-.8 1.7-1.2 2.7-1.2 2.2 0 4.1 1.7 4.1 4.4C17 12.9 10.5 17 10.5 17H10z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_text_2 }}
          </span>
          <span class="bp-rd-trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="3.5" y="8.5" width="13" height="8" rx="1" stroke="currentColor" stroke-width="1.4"/>
              <path d="M3.5 8.5H16.5V6.5C16.5 5.9 16 5.5 15.5 5.5H4.5C3.9 5.5 3.5 5.9 3.5 6.5V8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M10 5.5V16.5" stroke="currentColor" stroke-width="1.4"/>
              <path d="M10 5.5C10 5.5 8.5 2.5 6.7 3.1C5.3 3.6 5.6 5.5 6.5 5.5H10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M10 5.5C10 5.5 11.5 2.5 13.3 3.1C14.7 3.6 14.4 5.5 13.5 5.5H10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_text_3 }}
          </span>
        </div>
      </div>

      <div class="bp-rd-cta">
        <span class="bp-rd-cta-label">{{ section.settings.cta_label }}</span>
        <button type="button" class="bp-btn" id="BpRdWriteReview-{{ section.id }}">{{ section.settings.cta_text }}</button>
      </div>
    </div>

    <div class="bp-rd-grid" id="BpRdGrid-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if forloop.index <= 3 -%}
          {%- liquid
            assign rd_img_1 = block.settings.image
            if rd_img_1 != blank and rd_img_1 contains 'http'
              assign rd_img_1_url = rd_img_1
            elsif rd_img_1 != blank
              assign rd_img_1_url = rd_img_1 | asset_url
            else
              assign rd_img_1_url = blank
            endif
            assign rd_img_2 = block.settings.image_2
            if rd_img_2 != blank and rd_img_2 contains 'http'
              assign rd_img_2_url = rd_img_2
            elsif rd_img_2 != blank
              assign rd_img_2_url = rd_img_2 | asset_url
            else
              assign rd_img_2_url = blank
            endif
            assign rd_img_3 = block.settings.image_3
            if rd_img_3 != blank and rd_img_3 contains 'http'
              assign rd_img_3_url = rd_img_3
            elsif rd_img_3 != blank
              assign rd_img_3_url = rd_img_3 | asset_url
            else
              assign rd_img_3_url = blank
            endif
          -%}
          <div class="bp-rd-card" {{ block.shopify_attributes }}>
            <div class="bp-rd-card-body">
              <div class="bp-rd-top">
                <div class="bp-rd-header">
                  {%- if block.settings.variant != blank -%}
                    <span class="bp-rd-variant">{{ block.settings.variant }}</span>
                  {%- endif -%}
                  <span class="bp-rd-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= block.settings.stars -%}★{%- else -%}<span class="bp-rd-star-empty">★</span>{%- endif -%}
                    {%- endfor -%}
                  </span>
                </div>
                {%- if rd_img_1_url != blank or rd_img_2_url != blank or rd_img_3_url != blank -%}
                  {%- liquid
                    assign rd_photo_group = ''
                    if rd_img_1_url != blank
                      assign rd_photo_group = rd_img_1_url
                    endif
                    if rd_img_2_url != blank
                      assign rd_photo_group = rd_photo_group | append: '|' | append: rd_img_2_url
                    endif
                    if rd_img_3_url != blank
                      assign rd_photo_group = rd_photo_group | append: '|' | append: rd_img_3_url
                    endif
                  -%}
                  <div class="bp-rd-photos" data-photo-group="{{ rd_photo_group | escape }}">
                    {%- if rd_img_1_url != blank -%}
                      <button type="button" class="bp-rd-photo-btn" data-full="{{ rd_img_1_url }}" data-photo-index="0" aria-label="View photo from {{ block.settings.name }}'s review">
                        <img
                          src="{{ rd_img_1_url }}"
                          loading="lazy"
                          alt="Photo from {{ block.settings.name }}'s review"
                          width="90"
                          height="90"
                        >
                      </button>
                    {%- endif -%}
                    {%- if rd_img_2_url != blank -%}
                      <button type="button" class="bp-rd-photo-btn" data-full="{{ rd_img_2_url }}" data-photo-index="1" aria-label="View second photo from {{ block.settings.name }}'s review">
                        <img
                          src="{{ rd_img_2_url }}"
                          loading="lazy"
                          alt="Second photo from {{ block.settings.name }}'s review"
                          width="90"
                          height="90"
                        >
                      </button>
                    {%- endif -%}
                    {%- if rd_img_3_url != blank -%}
                      <button type="button" class="bp-rd-photo-btn" data-full="{{ rd_img_3_url }}" data-photo-index="2" aria-label="View third photo from {{ block.settings.name }}'s review">
                        <img
                          src="{{ rd_img_3_url }}"
                          loading="lazy"
                          alt="Third photo from {{ block.settings.name }}'s review"
                          width="90"
                          height="90"
                        >
                      </button>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.quote != blank -%}
                <p class="bp-rd-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
              {%- endif -%}
              <div class="bp-rd-meta">
                <span class="bp-rd-who">
                  {%- render 'bp-review-avatar', name: block.settings.name -%}
                  <span class="bp-rd-name">{{ block.settings.name }}</span>
                </span>
                <span>{{ block.settings.date }}</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.more_button_text != blank -%}
      <div class="bp-rd-more" id="BpRdMore-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 12.5C8 9.5 10.5 7 14 7C17.5 7 20 9.5 20 12.5C20 15.5 17.5 18 14 18C13.2 18 12.5 17.9 11.8 17.6L8.5 19L9.3 16.2C8.5 15.2 8 13.9 8 12.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M4 9.5C4 8 5.3 6.7 7 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <h3>{{ section.settings.more_heading }}</h3>
        <p>{{ section.settings.more_text | replace: '[count]', rd_total }}</p>
        <button type="button" class="bp-btn" id="BpRdShowMore-{{ section.id }}">{{ section.settings.more_button_text }}</button>
      </div>
    {%- endif -%}

    <div class="bp-rd-lightbox" id="BpRdLightbox-{{ section.id }}">
      <div class="bp-rd-lightbox-inner">
        <button type="button" class="bp-rd-lightbox-close" aria-label="Close photo">✕</button>
        <button type="button" class="bp-rd-lightbox-nav bp-rd-lightbox-prev" aria-label="Previous photo">‹</button>
        <img src="" alt="" id="BpRdLightboxImg-{{ section.id }}">
        <button type="button" class="bp-rd-lightbox-nav bp-rd-lightbox-next" aria-label="Next photo">›</button>
      </div>
    </div>

    <div
      class="bp-rd-modal"
      id="BpRdModal-{{ section.id }}"
      role="dialog"
      aria-modal="true"
      aria-label="All customer reviews"
      data-reviews-src="{{ 'bp-reviews-data.json' | asset_url }}"
    >
      <div class="bp-rd-modal-backdrop"></div>
      <div class="bp-rd-modal-panel">
        <div class="bp-rd-modal-head">
          <h3>{{ 'All reviews' }} <span class="bp-rd-modal-count">({{ rd_total }})</span></h3>
          <button type="button" class="bp-rd-modal-close" aria-label="Close reviews">✕</button>
        </div>
        <div class="bp-rd-modal-body">
          <div class="bp-rd-modal-grid" id="BpRdModalGrid-{{ section.id }}">
            <p class="bp-rd-modal-loading">Loading reviews…</p>
          </div>
        </div>
      </div>
    </div>

    <div class="bp-rd-modal" id="BpRdWriteModal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Write a review">
      <div class="bp-rd-modal-backdrop"></div>
      <div class="bp-rd-modal-panel bp-rd-write-panel">
        <div class="bp-rd-modal-head">
          <h3>Write a review</h3>
          <button type="button" class="bp-rd-modal-close" id="BpRdWriteModalClose-{{ section.id }}" aria-label="Close">✕</button>
        </div>
        <div class="bp-rd-modal-body">
{%- capture bp_write_form_id -%}BpRdWriteForm-{{ section.id }}{%- endcapture -%}
{%- form 'contact', id: bp_write_form_id -%}
  <div id="BpRdWriteFields-{{ section.id }}">
    <input type="hidden" name="contact[email]" id="BpRdWriteEmailHidden-{{ section.id }}" value="">
    <input type="hidden" name="contact[body]" id="BpRdWriteBodyHidden-{{ section.id }}">

    <div class="bp-rd-write-field">
      <label for="BpRdWriteName-{{ section.id }}">Name</label>
      <input type="text" id="BpRdWriteName-{{ section.id }}" placeholder="Your name" autocomplete="name" required>
    </div>

    <div class="bp-rd-write-field">
      <label for="BpRdWriteEmail-{{ section.id }}">Email</label>
      <input type="email" id="BpRdWriteEmail-{{ section.id }}" placeholder="you@example.com" autocomplete="email" required>
    </div>
    <div class="bp-rd-write-error" id="BpRdWriteError-{{ section.id }}" style="display:none;"></div>

    <div class="bp-rd-write-field">
      <label>Rating</label>
      <div class="bp-rd-write-stars" id="BpRdWriteStars-{{ section.id }}" role="radiogroup" aria-label="Star rating">
        {%- for i in (1..5) -%}
          <button type="button" class="bp-rd-write-star" data-value="{{ i }}" role="radio" aria-checked="false" aria-label="{{ i }} star{% if i != 1 %}s{% endif %}">★</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="bp-rd-write-field">
      <label for="BpRdWriteReviewText-{{ section.id }}">Your review</label>
      <textarea id="BpRdWriteReviewText-{{ section.id }}" placeholder="Tell us what you think — how does it hold up, what colour did you get, would you recommend it?" required></textarea>
    </div>

    <button type="submit" class="bp-btn bp-rd-write-submit" id="BpRdWriteSubmit-{{ section.id }}">Submit review</button>
  </div>

  <div class="bp-rd-write-success" id="BpRdWriteSuccess-{{ section.id }}" style="display:none;" tabindex="-1">
    Thank you! Your review has been sent to our team — we read every single one.
  </div>
{%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.bp-reviews-display-{{ section.id }}');
    if (!root) return;

    var bpRdAvatarPalette = ['#e57373', '#f06292', '#ba68c8', '#9575cd', '#7986cb', '#64b5f6', '#4fc3f7', '#4dd0e1', '#4db6ac', '#81c784', '#aed581', '#ffb74d', '#ff8a65', '#a1887f', '#90a4ae'];
    root.querySelectorAll('[data-bp-rd-avatar]').forEach(function (el) {
      var color = bpRdAvatarPalette[Math.floor(Math.random() * bpRdAvatarPalette.length)];
      el.style.background = color;
    });

    var lightbox = document.getElementById('BpRdLightbox-{{ section.id }}');
    var lightboxImg = document.getElementById('BpRdLightboxImg-{{ section.id }}');
    var closeBtn = lightbox ? lightbox.querySelector('.bp-rd-lightbox-close') : null;
    var prevBtn = lightbox ? lightbox.querySelector('.bp-rd-lightbox-prev') : null;
    var nextBtn = lightbox ? lightbox.querySelector('.bp-rd-lightbox-next') : null;
    if (!lightbox || !lightboxImg) return;

    var currentGroup = [];
    var currentIndex = 0;

    function updateNavVisibility() {
      var hasMultiple = currentGroup.length > 1;
      if (prevBtn) prevBtn.classList.toggle('is-visible', hasMultiple);
      if (nextBtn) nextBtn.classList.toggle('is-visible', hasMultiple);
    }

    function showIndex(index) {
      if (!currentGroup.length) return;
      currentIndex = (index + currentGroup.length) % currentGroup.length;
      lightboxImg.src = currentGroup[currentIndex];
    }

    function open(src, alt, group) {
      currentGroup = group && group.length ? group : [src];
      currentIndex = Math.max(0, currentGroup.indexOf(src));
      lightboxImg.alt = alt || '';
      showIndex(currentIndex);
      updateNavVisibility();
      lightbox.classList.add('is-open');
    }

    function close() {
      lightbox.classList.remove('is-open');
      lightboxImg.src = '';
      currentGroup = [];
    }

    root.querySelectorAll('.bp-rd-photo-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var img = btn.querySelector('img');
        var wrapper = btn.closest('.bp-rd-photos');
        var groupAttr = wrapper ? wrapper.getAttribute('data-photo-group') : '';
        var group = groupAttr ? groupAttr.split('|').filter(Boolean) : [];
        open(btn.getAttribute('data-full'), img ? img.alt : '', group);
      });
    });

    if (prevBtn) prevBtn.addEventListener('click', function () { showIndex(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { showIndex(currentIndex + 1); });

    if (closeBtn) closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', function (e) {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') showIndex(currentIndex - 1);
      if (e.key === 'ArrowRight') showIndex(currentIndex + 1);
    });

    var showMoreBtn = document.getElementById('BpRdShowMore-{{ section.id }}');
    var modal = document.getElementById('BpRdModal-{{ section.id }}');
    var modalGrid = document.getElementById('BpRdModalGrid-{{ section.id }}');
    var modalClose = modal ? modal.querySelector('.bp-rd-modal-close') : null;
    var modalBackdrop = modal ? modal.querySelector('.bp-rd-modal-backdrop') : null;
    var modalReviewsLoaded = false;

    function openModal(m) {
      if (!m) return;
      m.classList.add('is-open');
      document.body.classList.add('bp-rd-modal-lock');
    }

    function closeModal(m) {
      if (!m) return;
      m.classList.remove('is-open');
      document.body.classList.remove('bp-rd-modal-lock');
    }

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = str == null ? '' : String(str);
      return div.innerHTML;
    }

    function starsHtml(stars) {
      var out = '';
      for (var i = 1; i <= 5; i++) {
        out += i <= stars ? '★' : '<span class="bp-rd-star-empty">★</span>';
      }
      return out;
    }

    function resolveImageUrl(value) {
      if (!value) return '';
      if (value.indexOf('http') === 0) return value;
      // Fallback for legacy theme-asset-filename values (not expected for new data)
      return '{{ "x" | asset_url }}'.replace('x', value);
    }

    function avatarInitial(name) {
      var clean = (name || '').trim();
      return clean ? clean.charAt(0).toUpperCase() : '?';
    }

    function renderReviewCard(review) {
      var img1 = resolveImageUrl(review.image);
      var img2 = resolveImageUrl(review.image_2);
      var img3 = resolveImageUrl(review.image_3);
      var photoGroup = [img1, img2, img3].filter(Boolean).join('|');
      var name = escapeHtml(review.name);

      var photosHtml = '';
      if (img1 || img2 || img3) {
        var photoBtns = '';
        [img1, img2, img3].forEach(function (url, idx) {
          if (!url) return;
          var label = idx === 0 ? 'View photo from' : (idx === 1 ? 'View second photo from' : 'View third photo from');
          photoBtns += '<button type="button" class="bp-rd-photo-btn" data-full="' + escapeHtml(url) + '" data-photo-index="' + idx + '" aria-label="' + label + ' ' + name + '\'s review">' +
            '<img src="' + escapeHtml(url) + '" loading="lazy" alt="Photo from ' + name + '\'s review" width="90" height="90"></button>';
        });
        photosHtml = '<div class="bp-rd-photos" data-photo-group="' + escapeHtml(photoGroup) + '">' + photoBtns + '</div>';
      }

      var variantHtml = review.variant ? '<span class="bp-rd-variant">' + escapeHtml(review.variant) + '</span>' : '';
      var quoteHtml = review.quote ? '<p class="bp-rd-quote">&ldquo;' + escapeHtml(review.quote) + '&rdquo;</p>' : '';

      return (
        '<div class="bp-rd-card">' +
          '<div class="bp-rd-card-body">' +
            '<div class="bp-rd-top">' +
              '<div class="bp-rd-header">' + variantHtml +
                '<span class="bp-rd-stars" aria-label="' + review.stars + ' out of 5 stars">' + starsHtml(review.stars) + '</span>' +
              '</div>' + photosHtml +
            '</div>' + quoteHtml +
            '<div class="bp-rd-meta">' +
              '<span class="bp-rd-who">' +
                '<span class="bp-rd-avatar" data-bp-rd-avatar aria-hidden="true">' + escapeHtml(avatarInitial(review.name)) + '</span>' +
                '<span class="bp-rd-name">' + name + '</span>' +
              '</span>' +
              '<span>' + escapeHtml(review.date) + '</span>' +
            '</div>' +
          '</div>' +
        '</div>'
      );
    }

    function attachModalPhotoHandlers() {
      modalGrid.querySelectorAll('.bp-rd-photo-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var img = btn.querySelector('img');
          var wrapper = btn.closest('.bp-rd-photos');
          var groupAttr = wrapper ? wrapper.getAttribute('data-photo-group') : '';
          var group = groupAttr ? groupAttr.split('|').filter(Boolean) : [];
          open(btn.getAttribute('data-full'), img ? img.alt : '', group);
        });
      });
    }

    function loadModalReviews() {
      if (modalReviewsLoaded || !modal || !modalGrid) return;
      var src = modal.getAttribute('data-reviews-src');
      if (!src) return;
      fetch(src)
        .then(function (res) { return res.json(); })
        .then(function (reviews) {
          modalGrid.innerHTML = reviews.map(renderReviewCard).join('');
          var avatarPalette = ['#e57373', '#f06292', '#ba68c8', '#9575cd', '#7986cb', '#64b5f6', '#4fc3f7', '#4dd0e1', '#4db6ac', '#81c784', '#aed581', '#ffb74d', '#ff8a65', '#a1887f', '#90a4ae'];
          modalGrid.querySelectorAll('[data-bp-rd-avatar]').forEach(function (el) {
            el.style.background = avatarPalette[Math.floor(Math.random() * avatarPalette.length)];
          });
          attachModalPhotoHandlers();
          modalReviewsLoaded = true;
        })
        .catch(function () {
          modalGrid.innerHTML = '<p class="bp-rd-modal-loading">Couldn\'t load reviews right now — please refresh and try again.</p>';
        });
    }

    if (showMoreBtn && modal) {
      showMoreBtn.addEventListener('click', function () {
        openModal(modal);
        loadModalReviews();
      });
    }
    if (modalClose) modalClose.addEventListener('click', function () { closeModal(modal); });
    if (modalBackdrop) modalBackdrop.addEventListener('click', function () { closeModal(modal); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeModal(modal);
        closeModal(writeModal);
      }
    });

    // Write-a-review popup
var writeBtn = document.getElementById('BpRdWriteReview-{{ section.id }}');
var writeModal = document.getElementById('BpRdWriteModal-{{ section.id }}');
var writeModalClose = writeModal ? document.getElementById('BpRdWriteModalClose-{{ section.id }}') : null;
var writeModalBackdrop = writeModal ? writeModal.querySelector('.bp-rd-modal-backdrop') : null;
var writeFields = document.getElementById('BpRdWriteFields-{{ section.id }}');
var writeSuccess = document.getElementById('BpRdWriteSuccess-{{ section.id }}');
var writeError = document.getElementById('BpRdWriteError-{{ section.id }}');
var writeSubmitBtn = document.getElementById('BpRdWriteSubmit-{{ section.id }}');
var writeForm = document.getElementById('BpRdWriteForm-{{ section.id }}');

function resetWriteForm() {
  if (writeFields) writeFields.style.display = '';
  if (writeSuccess) writeSuccess.style.display = 'none';
  if (writeError) writeError.style.display = 'none';
}

if (writeBtn && writeModal) {
  writeBtn.addEventListener('click', function () {
    resetWriteForm();
    openModal(writeModal);
  });
}
if (writeModalClose) writeModalClose.addEventListener('click', function () { closeModal(writeModal); });
if (writeModalBackdrop) writeModalBackdrop.addEventListener('click', function () { closeModal(writeModal); });

var writeStars = document.querySelectorAll('#BpRdWriteStars-{{ section.id }} .bp-rd-write-star');
var writeRating = 0;
writeStars.forEach(function (star) {
  star.addEventListener('click', function () {
    writeRating = parseInt(star.getAttribute('data-value'), 10);
    writeStars.forEach(function (s) {
      var active = parseInt(s.getAttribute('data-value'), 10) <= writeRating;
      s.classList.toggle('is-active', active);
      s.setAttribute('aria-checked', active ? 'true' : 'false');
    });
  });
});

if (writeForm) {
  writeForm.addEventListener('submit', function (e) {
    e.preventDefault();

    var nameEl = document.getElementById('BpRdWriteName-{{ section.id }}');
    var emailEl = document.getElementById('BpRdWriteEmail-{{ section.id }}');
    var reviewEl = document.getElementById('BpRdWriteReviewText-{{ section.id }}');
    var emailHidden = document.getElementById('BpRdWriteEmailHidden-{{ section.id }}');
    var bodyHidden = document.getElementById('BpRdWriteBodyHidden-{{ section.id }}');

    writeError.style.display = 'none';

    if (writeRating < 1) {
      writeError.textContent = 'Please select a star rating before submitting.';
      writeError.style.display = 'block';
      return;
    }
    if (!nameEl.value.trim() || !emailEl.checkValidity() || !reviewEl.value.trim()) {
      writeError.textContent = 'Please fill in your name, a valid email, and your review.';
      writeError.style.display = 'block';
      return;
    }

    emailHidden.value = emailEl.value;
    bodyHidden.value = [
      'New product review submitted via velagoods.co.uk',
      '',
      'Name: ' + nameEl.value,
      'Email: ' + emailEl.value,
      'Rating: ' + writeRating + ' / 5',
      '',
      'Review:',
      reviewEl.value
    ].join('\n');

    writeSubmitBtn.disabled = true;
    writeSubmitBtn.textContent = 'Sending…';

    fetch(writeForm.action, {
      method: 'POST',
      body: new FormData(writeForm)
    })
      .then(function (response) {
        if (!response.ok) throw new Error('Request failed');
        writeFields.style.display = 'none';
        writeSuccess.style.display = 'block';
        writeSuccess.focus();
      })
      .catch(function () {
        writeError.textContent = 'Something went wrong sending your review — please try again.';
        writeError.style.display = 'block';
      })
      .finally(function () {
        writeSubmitBtn.disabled = false;
        writeSubmitBtn.textContent = 'Submit review';
      });
  });
}
  })();
</script>

{% schema %}
{
  "name": "BP Reviews Display",
  "tag": "section",
  "class": "section-bp-reviews-display",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT DO CUSTOMERS SAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real customers, real Bunny Perches" },
    { "type": "text", "id": "overall_rating", "label": "Overall rating (shown large)", "default": "4.6" },
    { "type": "number", "id": "star_5_count", "label": "5-star review count", "default": 950 },
    { "type": "number", "id": "star_4_count", "label": "4-star review count", "default": 280 },
    { "type": "number", "id": "star_3_count", "label": "3-star review count", "default": 60 },
    { "type": "number", "id": "star_2_count", "label": "2-star review count", "default": 17 },
    { "type": "number", "id": "star_1_count", "label": "1-star review count", "default": 10 },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Share your experience" },
    { "type": "text", "id": "cta_text", "label": "CTA button text", "default": "Write a review" },
    { "type": "header", "content": "Trust row (shown above the reviews)" },
    { "type": "textarea", "id": "trust_description", "label": "Description", "default": "Customers love the quality, practicality, and design of our phone stands." },
    { "type": "text", "id": "trust_text_1", "label": "Trust item 1", "default": "Great quality" },
    { "type": "text", "id": "trust_text_2", "label": "Trust item 2", "default": "Useful & practical" },
    { "type": "text", "id": "trust_text_3", "label": "Trust item 3", "default": "Perfect gift" },
    { "type": "header", "content": "\"Show more\" box (shown after the first 3 reviews)" },
    { "type": "text", "id": "more_heading", "label": "Heading", "default": "More happy customers" },
    { "type": "text", "id": "more_text", "label": "Text", "info": "Use [count] to insert the total review count", "default": "Join [count]+ customers who love our phone stands." },
    { "type": "text", "id": "more_button_text", "label": "Button text", "default": "Show more reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "image", "label": "Photo (optional)", "info": "A full image URL (e.g. from Shopify Files/CDN) or a filename of an image uploaded to this theme's Assets folder" },
        { "type": "text", "id": "image_2", "label": "Second photo (optional)", "info": "A full image URL or a theme Assets filename" },
        { "type": "text", "id": "image_3", "label": "Third photo (optional)", "info": "A full image URL or a theme Assets filename" },
