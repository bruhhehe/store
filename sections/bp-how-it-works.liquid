{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div id="bp-how-it-works" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section bp-how-{{ section.id }}" id="HowItWorks-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-how-{{ section.id }} .bp-how-grid{
      max-width:1000px; margin:0 auto; padding:0 24px;
      display:grid; grid-template-columns: repeat(3, 1fr); gap:36px; text-align:center;
    }
    .bp-how-{{ section.id }} .bp-step-num{
      width:52px; height:52px; border-radius:50%; border:1px solid {{ section.settings.accent_color }};
      display:flex; align-items:center; justify-content:center; margin:0 auto 18px;
      font-family: var(--bp-serif); font-size:18px; color:{{ section.settings.accent_color }};
    }
    .bp-how-{{ section.id }} h3{ font-size:18px; margin-bottom:10px; }
    .bp-how-{{ section.id }} p{ font-size:14px; color:var(--bp-muted); margin:0; }
    @media (max-width:700px){
      .bp-how-{{ section.id }} .bp-how-grid{ grid-template-columns:1fr; gap:30px; }
    }
  </style>

  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom:44px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="bp-how-grid">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <div class="bp-step-num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP How it works",
  "tag": "section",
  "class": "section-bp-how",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c96a86" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set it once, use it every day" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Place it on your desk" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Set the base wherever you need it — desk, nightstand, or kitchen counter." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "BP How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Place it on your desk", "text": "Set the base wherever you need it — desk, nightstand, or kitchen counter." } },
        { "type": "step", "settings": { "title": "Adjust height & angle", "text": "Slide and tilt until the screen lines up with your eyes or your task at hand." } },
        { "type": "step", "settings": { "title": "Rest your device, go hands-free", "text": "The anti-slip padding grips your phone or tablet securely while you work, cook, or watch." } }
      ]
    }
  ]
}
{% endschema %}
