{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div id="bp-returns" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section bp-returns-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-returns-{{ section.id }} .bp-returns-card {
      max-width: 720px;
      margin: 0 auto;
      background: #fff;
      border-radius: 20px;
      padding: 38px;
      box-shadow: 0 1px 2px rgba(43,30,34,.05);
    }
    .bp-returns-{{ section.id }} .bp-returns-highlight {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(63,122,79,.08);
      border: 1px solid rgba(63,122,79,.2);
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 28px;
      font-size: 15px;
      font-weight: 600;
      color: var(--bp-ink);
    }
    .bp-returns-{{ section.id }} .bp-returns-highlight svg {
      width: 22px;
      height: 22px;
      flex: none;
      color: var(--bp-green);
    }
    .bp-returns-{{ section.id }} h3 {
      font-size: 17px;
      margin: 28px 0 10px;
    }
    .bp-returns-{{ section.id }} h3:first-of-type {
      margin-top: 0;
    }
    .bp-returns-{{ section.id }} p {
      font-size: 14.5px;
      line-height: 1.65;
      color: var(--bp-ink);
      margin: 0 0 8px;
    }
    .bp-returns-{{ section.id }} .bp-returns-muted {
      color: var(--bp-muted);
    }
    .bp-returns-{{ section.id }} a {
      color: var(--bp-pink-deep);
      text-decoration: underline;
    }
    .bp-returns-{{ section.id }} ul {
      margin: 0 0 8px;
      padding-left: 20px;
      font-size: 14.5px;
      line-height: 1.65;
    }
    .bp-returns-{{ section.id }} li {
      margin-bottom: 4px;
    }
  </style>

  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom: 36px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
      <p style="color:var(--bp-muted); margin-top:10px;">{{ section.settings.subheading }}</p>
    </div>

    <div class="bp-returns-card">
      <div class="bp-returns-highlight">
        <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.4"/>
          <path d="M5.5 10.2L8.3 13L14.5 6.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ section.settings.highlight_text }}
      </div>

      <h3>{{ section.settings.eligibility_title }}</h3>
      <p>{{ section.settings.eligibility_text }}</p>

      <h3>{{ section.settings.how_title }}</h3>
      <p>{{ section.settings.how_text }}</p>

      <h3>{{ section.settings.damages_title }}</h3>
      <p>{{ section.settings.damages_text }}</p>

      <h3>{{ section.settings.exceptions_title }}</h3>
      <p>{{ section.settings.exceptions_text }}</p>

      <h3>{{ section.settings.eu_title }}</h3>
      <p>{{ section.settings.eu_text }}</p>

      <h3>{{ section.settings.refund_title }}</h3>
      <p>{{ section.settings.refund_text }}</p>

      <p class="bp-returns-muted" style="margin-top: 20px;">{{ section.settings.footer_text }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP Returns",
  "tag": "section",
  "class": "section-bp-returns",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RETURNS & REFUNDS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our 30-day return policy" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Not the right fit? We've got you covered." },
    { "type": "text", "id": "highlight_text", "label": "Highlight banner text", "default": "30 days to request a return from when you receive your order" },
    { "type": "text", "id": "eligibility_title", "label": "Eligibility section title", "default": "Eligibility" },
    { "type": "textarea", "id": "eligibility_text", "label": "Eligibility text", "default": "To be eligible for a return, your item must be in the same condition that you received it, unworn or unused, with tags, and in its original packaging. You'll also need the receipt or proof of purchase." },
    { "type": "text", "id": "how_title", "label": "How to return section title", "default": "How to start a return" },
    { "type": "textarea", "id": "how_text", "label": "How to return text", "default": "Contact us at support@velagoods.co.uk to request a return. If accepted, we'll send you a return shipping label and instructions on how and where to send your package. Items sent back without first requesting a return will not be accepted." },
    { "type": "text", "id": "damages_title", "label": "Damages section title", "default": "Damages and issues" },
    { "type": "textarea", "id": "damages_text", "label": "Damages text", "default": "Please inspect your order upon reception and contact us immediately if the item is defective, damaged, or if you receive the wrong item, so we can evaluate the issue and make it right." },
    { "type": "text", "id": "exceptions_title", "label": "Exceptions section title", "default": "Exceptions" },
    { "type": "textarea", "id": "exceptions_text", "label": "Exceptions text", "default": "Unfortunately, we cannot accept returns on sale items or gift cards. Please get in touch if you have questions about a specific item." },
    { "type": "text", "id": "eu_title", "label": "EU cooling-off section title", "default": "EU 14-day cooling off period" },
    { "type": "textarea", "id": "eu_text", "label": "EU cooling-off text", "default": "If your order is shipped into the European Union, you have the right to cancel or return your order within 14 days, for any reason, without a justification. Your item must still be in the same condition you received it, unworn or unused, with tags, and in its original packaging." },
    { "type": "text", "id": "refund_title", "label": "Refunds section title", "default": "Refunds" },
    { "type": "textarea", "id": "refund_text", "label": "Refunds text", "default": "We'll notify you once we've received and inspected your return, and let you know if it's approved. If approved, you'll be automatically refunded on your original payment method within 10 business days. It can take extra time for your bank or card provider to post the refund." },
    { "type": "text", "id": "footer_text", "label": "Footer note", "default": "Questions about a return? Email support@velagoods.co.uk and we'll help sort it out." }
  ],
  "presets": [{ "name": "BP Returns" }]
}
{% endschema %}
