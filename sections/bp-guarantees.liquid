{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-guar-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-guar-{{ section.id }} .bp-guar-grid{
      max-width:1000px; margin:0 auto; padding:0 24px;
      display:grid; grid-template-columns: repeat(4, 1fr); gap:30px; text-align:center;
    }
    .bp-guar-{{ section.id }} .bp-guar-icon{ font-size:30px; margin-bottom:12px; }
    .bp-guar-{{ section.id }} h3{ font-size:15px; margin-bottom:6px; font-family: var(--bp-sans); font-weight:700; }
    .bp-guar-{{ section.id }} p{ font-size:13px; color:var(--bp-muted); margin:0; }
    @media (max-width:700px){
      .bp-guar-{{ section.id }} .bp-guar-grid{ grid-template-columns: 1fr 1fr; gap:26px; }
    }
  </style>
  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom:44px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="bp-guar-grid">
      {% for block in section.blocks %}
        <div {{ block.shopify_attributes }}>
          <div class="bp-guar-icon">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP Guarantees strip",
  "tag": "section",
  "class": "section-bp-guarantees",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY SHOP WITH CONFIDENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backed by real guarantees, not just words" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "🛡️" },
        { "type": "text", "id": "title", "label": "Title", "default": "30-day guarantee" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Not happy with the fit or stability? Full refund, no questions asked." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BP Guarantees strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "🛡️", "title": "30-day guarantee", "text": "Not happy with the fit or stability? Full refund, no questions asked." } },
        { "type": "item", "settings": { "icon": "🔒", "title": "Secure checkout", "text": "SSL-encrypted payments processed through Shopify Payments." } },
        { "type": "item", "settings": { "icon": "📦", "title": "Tracked UK shipping", "text": "Every order ships free with real-time tracking from dispatch to your door." } },
        { "type": "item", "settings": { "icon": "💬", "title": "Real human support", "text": "Email us and get a reply from our team within 24 hours, 7 days a week." } }
      ]
    }
  ]
}
{% endschema %}
