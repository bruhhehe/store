{%- if section.blocks.size > 0 -%}
  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var tiers = document.querySelectorAll('#FeaturedOffer-' + sectionId + ' .fc-tier');
      var quantityInput = document.getElementById('FcQuantity-' + sectionId);
      var submitBtn = document.getElementById('FcSubmit-' + sectionId);
      var returnToInput = document.getElementById('FcReturnTo-' + sectionId);
      var priceEl = document.getElementById('FcPrice-' + sectionId);
      var comparePriceEl = document.getElementById('FcComparePrice-' + sectionId);
      var savingsEl = document.getElementById('FcSavings-' + sectionId);
      var unitPriceEl = document.getElementById('FcUnitPrice-' + sectionId);
      var compareAtCents = {{ variant.compare_at_price | default: 0 }};

      // Stash the button's "resting" label (not the transient "Adding…"
      // state) so it can be restored correctly if the shopper navigates
      // to checkout and then hits Back — see the pageshow listener in
      // the submit script below.
      if (submitBtn) submitBtn.dataset.defaultText = submitBtn.textContent;

      tiers.forEach(function (tier) {
        tier.addEventListener('click', function () {
          tiers.forEach(function (t) {
            t.setAttribute('aria-checked', 'false');
          });
          tier.setAttribute('aria-checked', 'true');

          var qty = parseInt(tier.getAttribute('data-quantity'), 10) || 1;
          var priceCents = parseInt(tier.getAttribute('data-price'), 10) || 0;
          var discountCode = (tier.getAttribute('data-discount-code') || '').trim();

          if (quantityInput) quantityInput.value = qty;

          if (submitBtn) {
            submitBtn.textContent = 'Checkout — ' + formatMoney(priceCents);
            submitBtn.dataset.defaultText = submitBtn.textContent;
          }

          // Reflect this tier's total (and exact savings) in the top price
          // row, instead of always showing the single-unit price.
          if (priceEl) priceEl.textContent = formatMoney(priceCents);
          if (unitPriceEl) {
            if (qty > 1) {
              var unitCents = Math.floor(priceCents / qty);
              unitPriceEl.textContent = formatMoney(unitCents) + ' per stand';
              unitPriceEl.style.display = '';
            } else {
              unitPriceEl.style.display = 'none';
            }
          }
          if (compareAtCents > 0) {
            var compareTotalCents = compareAtCents * qty;
            var savingsCents = compareTotalCents - priceCents;
            if (comparePriceEl) comparePriceEl.textContent = formatMoney(compareTotalCents);
            if (savingsEl) {
              if (savingsCents > 0) {
                var savingsPercent = Math.round((savingsCents / compareTotalCents) * 100);
                savingsEl.textContent = 'You save ' + formatMoney(savingsCents) + ' (' + savingsPercent + '%)';
                savingsEl.style.display = '';
              } else {
                savingsEl.style.display = 'none';
              }
            }
          }

          // Route the redirect straight to checkout (skipping the cart page)
          // through Shopify's discount activation endpoint when this tier has
          // a code attached, so the saving applies automatically — no code
          // entry needed. Tiers with no code (e.g. the base price already
          // reflects the offer) go straight to checkout as-is.
          if (returnToInput) {
            returnToInput.value = discountCode
              ? '/discount/' + encodeURIComponent(discountCode) + '?redirect=/checkout'
              : '/checkout';
          }

          document.dispatchEvent(new CustomEvent('fc:tierchange', {
            detail: { sectionId: sectionId, quantity: qty }
          }));
        });
      });

      function formatMoney(cents) {
        return (cents / 100).toLocaleString(undefined, {
          style: 'currency',
          currency: {{ cart.currency.iso_code | json }}
        });
      }
    })();
  </script>
{%- endif -%}

