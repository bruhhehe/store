{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-announce-{{ section.id }}" style="background:{{ section.settings.bg_color }}; color:{{ section.settings.text_color }};">
  <style>
    .bp-announce-{{ section.id }} .bp-announce-inner{
      max-width:1180px; margin:0 auto; padding:9px 24px; text-align:center; font-size:13px;
    }
    .bp-announce-{{ section.id }} a{ color:{{ section.settings.text_color }}; text-decoration:underline; }
  </style>
  <div class="bp-announce-inner">
    {{ section.settings.text }}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "BP Announcement bar",
  "tag": "section",
  "class": "section-bp-announce",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2b1e22" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "text", "id": "text", "label": "Message", "default": "Free UK shipping on every order · 30-day money-back guarantee" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop now" }
  ],
  "presets": [{ "name": "BP Announcement bar" }]
}
{% endschema %}
