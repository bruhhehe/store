{%- comment -%} BP UGC videos section {%- endcomment -%}
{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-ugc-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-ugc-{{ section.id }} .bp-ugc-grid {
      max-width: 1180px;
      margin: 0 auto;
      padding: 64px 24px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    @media (max-width: 900px) {
      .bp-ugc-{{ section.id }} .bp-ugc-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .bp-ugc-{{ section.id }} .bp-ugc-grid { grid-template-columns: 1fr 1fr; gap: 12px; padding: 40px 16px; }
    }
    .bp-ugc-{{ section.id }} .bp-ugc-card {
      position: relative;
      aspect-ratio: 9 / 16;
      border-radius: var(--bp-radius);
      overflow: hidden;
      background: {{ section.settings.placeholder_bg }};
      border: none;
      padding: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-card img,
    .bp-ugc-{{ section.id }} .bp-ugc-card video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-placeholder-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(255,255,255,0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-placeholder-icon svg {
      width: 20px;
      height: 20px;
      color: var(--bp-pink-deep);
      margin-left: 3px;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-play-badge {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(43, 30, 34, 0.15);
      transition: background 0.15s ease;
      z-index: 1;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-card:hover .bp-ugc-play-badge {
      background: rgba(43, 30, 34, 0.3);
    }
    .bp-ugc-{{ section.id }} .bp-ugc-play-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(255,255,255,0.95);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-play-icon svg {
      width: 20px;
      height: 20px;
      color: var(--bp-pink-deep);
      margin-left: 3px;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 14px 12px 12px;
      background: linear-gradient(to top, rgba(43,30,34,0.75), rgba(43,30,34,0));
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      z-index: 2;
      text-align: left;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal.is-open { display: flex; }
    .bp-ugc-{{ section.id }} .bp-ugc-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.75);
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal-panel {
      position: relative;
      z-index: 1;
      width: min(90vw, 380px);
      aspect-ratio: 9 / 16;
      background: #000;
      border-radius: var(--bp-radius);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal-panel video,
    .bp-ugc-{{ section.id }} .bp-ugc-modal-panel iframe {
      width: 100%;
      height: 100%;
      border: none;
      object-fit: cover;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal-empty {
      color: #fff;
      text-align: center;
      padding: 32px;
      font-size: 14px;
      line-height: 1.6;
    }
    .bp-ugc-{{ section.id }} .bp-ugc-modal-close {
      position: absolute;
      top: -44px;
      right: 0;
      background: none;
      border: none;
      color: #fff;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      padding: 6px;
    }
  </style>

  <div class="bp-wrap" style="padding-bottom: 0;">
    <div class="bp-center">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p style="color:var(--bp-muted); margin-top:12px;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="bp-ugc-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign has_video = false
        if block.settings.video_url != blank
          assign has_video = true
        endif
      -%}
      <button
        type="button"
        class="bp-ugc-card"
        data-ugc-trigger
        data-video-url="{{ block.settings.video_url | escape }}"
        data-video-type="{{ block.settings.video_type }}"
        aria-label="{% if has_video %}Play video{% if block.settings.caption != blank %} — {{ block.settings.caption }}{% endif %}{% else %}Video coming soon{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.thumbnail != blank -%}
          <img src="{{ block.settings.thumbnail | image_url: width: 600 }}" loading="lazy" alt="{{ block.settings.caption | default: 'Customer video' }}">
        {%- endif -%}

        {%- if has_video -%}
          <span class="bp-ugc-play-badge">
            <span class="bp-ugc-play-icon">
              <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6 4L16 10L6 16V4Z"/></svg>
            </span>
          </span>
        {%- else -%}
          <span class="bp-ugc-placeholder-icon">
            <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6 4L16 10L6 16V4Z"/></svg>
          </span>
        {%- endif -%}

        {%- if block.settings.caption != blank -%}
          <span class="bp-ugc-caption">{{ block.settings.caption }}</span>
        {%- endif -%}
      </button>
    {%- endfor -%}
  </div>

  <div class="bp-ugc-modal" id="BpUgcModal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Customer video">
    <div class="bp-ugc-modal-backdrop"></div>
    <div class="bp-ugc-modal-panel">
      <button type="button" class="bp-ugc-modal-close" aria-label="Close video">✕</button>
      <div class="bp-ugc-modal-body"></div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.bp-ugc-{{ section.id }}');
    if (!root) return;

    var modal = document.getElementById('BpUgcModal-{{ section.id }}');
    var modalBody = modal.querySelector('.bp-ugc-modal-body');
    var closeBtn = modal.querySelector('.bp-ugc-modal-close');
    var backdrop = modal.querySelector('.bp-ugc-modal-backdrop');

    function openModal(url, type) {
      modalBody.innerHTML = '';
      if (!url) {
        var empty = document.createElement('div');
        empty.className = 'bp-ugc-modal-empty';
        empty.textContent = {{ section.settings.empty_state_text | json }};
        modalBody.appendChild(empty);
      } else if (type === 'embed') {
        var iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        modalBody.appendChild(iframe);
      } else {
        var video = document.createElement('video');
        video.src = url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        modalBody.appendChild(video);
      }
      modal.classList.add('is-open');
      document.body.classList.add('bp-rd-modal-lock');
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modalBody.innerHTML = '';
      document.body.classList.remove('bp-rd-modal-lock');
    }

    root.querySelectorAll('[data-ugc-trigger]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openModal(btn.getAttribute('data-video-url'), btn.getAttribute('data-video-type'));
      });
    });

    closeBtn.addEventListener('click', closeModal);
    backdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>

{% schema %}
{
  "name": "BP UGC videos",
  "tag": "section",
  "class": "section-bp-ugc-videos",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "color", "id": "placeholder_bg", "label": "Placeholder background", "default": "#f6c9d3" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEE IT IN ACTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by real customers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real videos from people using their Bunny Perch every day." },
    { "type": "text", "id": "empty_state_text", "label": "Placeholder message (shown when a block has no video yet)", "default": "Video coming soon — check back shortly!" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "text", "id": "video_url", "label": "Video URL (optional)", "info": "A direct video file URL (.mp4) or, if using Embed below, an embeddable player URL (e.g. YouTube/TikTok embed link). Leave blank to show a placeholder." },
        { "type": "select", "id": "video_type", "label": "Video type", "options": [
            { "value": "file", "label": "Direct video file (.mp4)" },
            { "value": "embed", "label": "Embed link (YouTube/TikTok/etc.)" }
          ], "default": "file" },
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail image (optional)", "info": "Shown as the cover image before the video is played" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "BP UGC videos",
      "blocks": [
        { "type": "video", "settings": { "caption": "\"Didn't expect to use it this much\"" } },
        { "type": "video", "settings": { "caption": "Unboxing + first setup" } },
        { "type": "video", "settings": { "caption": "Desk setup tour" } },
        { "type": "video", "settings": { "caption": "\"Perfect for hands-free calls\"" } }
      ]
    }
  ]
}
{% endschema %}
