{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div id="bp-shipping" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section bp-ship-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-ship-{{ section.id }} .bp-ship-card{
      max-width:560px; margin:0 auto; background:#fff; border-radius:20px; padding:38px;
      text-align:center; box-shadow: 0 1px 2px rgba(43,30,34,.05);
    }
    .bp-ship-{{ section.id }} .bp-ship-flag{ font-size:34px; margin-bottom:14px; }
    .bp-ship-{{ section.id }} h3{ font-size:20px; margin-bottom:14px; }
    .bp-ship-{{ section.id }} .bp-ship-row{
      display:flex; justify-content:space-between; font-size:14px; padding:10px 0;
      border-bottom:1px solid rgba(43,30,34,.06);
    }
    .bp-ship-{{ section.id }} .bp-ship-row:last-child{ border-bottom:none; }
    .bp-ship-{{ section.id }} .bp-ship-row span:first-child{ color: var(--bp-muted); }
    .bp-ship-{{ section.id }} .bp-ship-row span:last-child{ font-weight:600; }
    .bp-ship-{{ section.id }} .bp-free{ color: var(--bp-green); }
  </style>
  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom:36px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
      <p style="color:var(--bp-muted); margin-top:10px;">{{ section.settings.subheading }}</p>
    </div>
    <div class="bp-ship-card">
      <div class="bp-ship-flag">🇬🇧</div>
      <h3>{{ section.settings.card_title }}</h3>
      <div class="bp-ship-row"><span>Processing time</span><span>{{ section.settings.processing_time }}</span></div>
      <div class="bp-ship-row"><span>Delivery time</span><span>{{ section.settings.delivery_time }}</span></div>
      <div class="bp-ship-row"><span>Shipping cost</span><span class="bp-free">{{ section.settings.shipping_cost }}</span></div>
      <div class="bp-ship-row"><span>Tracking</span><span>{{ section.settings.tracking_text }} — <a href="https://velagoods.co.uk/a/tracking" style="color:inherit; text-decoration:underline;">Track your order</a></span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP UK Shipping",
  "tag": "section",
  "class": "section-bp-shipping-uk",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fbe9ec" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHIPPING & DELIVERY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free UK shipping, every order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "We currently ship to UK addresses only, at no extra cost." },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "United Kingdom" },
    { "type": "text", "id": "processing_time", "label": "Processing time", "default": "1–2 business days" },
    { "type": "text", "id": "delivery_time", "label": "Delivery time", "default": "3–6 business days" },
    { "type": "text", "id": "shipping_cost", "label": "Shipping cost", "default": "Free" },
    { "type": "text", "id": "tracking_text", "label": "Tracking text", "default": "Included on every order" }
  ],
  "presets": [{ "name": "BP UK Shipping" }]
}
{% endschema %}
