{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-news-{{ section.id }}" style="background:{{ section.settings.section_bg }};">
  <style>
    .bp-news-{{ section.id }} .bp-news-card{
      max-width:900px; margin:0 auto; background:{{ section.settings.card_bg }};
      color:#fff; border-radius:24px; padding:48px 32px; text-align:center;
    }
    .bp-news-{{ section.id }} h2{ font-size:26px; color:#fff; margin-bottom:10px; }
    .bp-news-{{ section.id }} p{ font-size:14px; color: rgba(255,255,255,.75); margin-bottom:24px; }
    .bp-news-{{ section.id }} form{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; max-width:440px; margin:0 auto; }
    .bp-news-{{ section.id }} input[type="email"]{
      flex:1; min-width:220px; padding:13px 16px; border-radius:999px; border:1px solid rgba(255,255,255,.2);
      background: rgba(255,255,255,.08); color:#fff; font-size:14px;
    }
    .bp-news-{{ section.id }} input[type="email"]::placeholder{ color: rgba(255,255,255,.55); }
  </style>
  <div class="bp-wrap">
    <div class="bp-news-card">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
          <input type="email" name="contact[email]" placeholder="you@email.com" required>
          <button type="submit" class="bp-btn">{{ section.settings.button_text }}</button>
        </div>
        {% if form.posted_successfully? %}
          <p style="color:#fff; margin-top:12px;">Thanks — check your inbox for your code!</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP Newsletter",
  "tag": "section",
  "class": "section-bp-newsletter",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#fdf3f4" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#2b1e22" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Join our list for desk-setup ideas, restock alerts, and early access to sales." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Get my code" }
  ],
  "presets": [{ "name": "BP Newsletter" }]
}
{% endschema %}
