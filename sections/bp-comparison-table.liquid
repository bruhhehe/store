{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section bp-comp-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .bp-comp-{{ section.id }} table{ width:100%; border-collapse:collapse; background:#fff; border-radius:16px; overflow:hidden; }
    .bp-comp-{{ section.id }} th, .bp-comp-{{ section.id }} td{ padding:16px 20px; text-align:center; font-size:14px; border-bottom:1px solid rgba(43,30,34,.06); }
    .bp-comp-{{ section.id }} th:first-child, .bp-comp-{{ section.id }} td:first-child{ text-align:left; font-weight:600; }
    .bp-comp-{{ section.id }} thead th{ font-size:13px; text-transform:none; color:var(--bp-muted); font-weight:600; padding-top:20px; padding-bottom:16px; }
    .bp-comp-{{ section.id }} .bp-brand-col{ background: {{ section.settings.highlight_bg }}; color: {{ section.settings.accent_color }}; font-weight:700; }
    .bp-comp-{{ section.id }} .bp-yes{ color: var(--bp-green); font-weight:700; }
    .bp-comp-{{ section.id }} .bp-no{ color: var(--bp-red); font-weight:700; }
    .bp-comp-{{ section.id }} .bp-table-wrap{ overflow-x:auto; }
  </style>

  <div class="bp-wrap">
    <div class="bp-center" style="margin-bottom:36px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:30px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="bp-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th class="bp-brand-col">{{ section.settings.brand_name }}</th>
            <th>{{ section.settings.competitor1 }}</th>
            <th>{{ section.settings.competitor2 }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="bp-brand-col">{{ block.settings.brand_value }}</td>
              <td>{{ block.settings.competitor1_value }}</td>
              <td>{{ block.settings.competitor2_value }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BP Comparison table",
  "tag": "section",
  "class": "section-bp-comparison",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf3f4" },
    { "type": "color", "id": "highlight_bg", "label": "Brand column background", "default": "#f6c9d3" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#a8496a" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW BUNNY PERCH COMPARES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop re-propping your phone every five minutes" },
    { "type": "text", "id": "brand_name", "label": "Your brand column name", "default": "Bunny Perch" },
    { "type": "text", "id": "competitor1", "label": "Competitor 1 name", "default": "Basic flat stand" },
    { "type": "text", "id": "competitor2", "label": "Competitor 2 name", "default": "Clip-on car mount" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature" },
        { "type": "text", "id": "brand_value", "label": "Your value" },
        { "type": "text", "id": "competitor1_value", "label": "Competitor 1 value" },
        { "type": "text", "id": "competitor2_value", "label": "Competitor 2 value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BP Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Adjustable height", "brand_value": "✓", "competitor1_value": "Fixed", "competitor2_value": "✕" } },
        { "type": "row", "settings": { "feature": "Multiple viewing angles", "brand_value": "✓", "competitor1_value": "One angle", "competitor2_value": "Limited" } },
        { "type": "row", "settings": { "feature": "Fits most tablets", "brand_value": "Most tablets", "competitor1_value": "Rarely", "competitor2_value": "✕" } },
        { "type": "row", "settings": { "feature": "Anti-slip padding", "brand_value": "Padded", "competitor1_value": "Bare plastic", "competitor2_value": "Hard clip" } },
        { "type": "row", "settings": { "feature": "Stable on desk", "brand_value": "Wide base", "competitor1_value": "Lightweight, tips easily", "competitor2_value": "N/A" } },
        { "type": "row", "settings": { "feature": "Designed to display", "brand_value": "✓", "competitor1_value": "✕", "competitor2_value": "✕" } }
      ]
    }
  ]
}
{% endschema %}
